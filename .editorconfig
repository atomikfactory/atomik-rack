root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.rs]
max_line_length = 100

[*.{toml,yml,yaml,json,atomik}]
indent_size = 2

[*.md]
indent_size = 2
# Two trailing spaces are a hard line break in Markdown.
trim_trailing_whitespace = false

[*.sh]
indent_size = 2

[Cargo.lock]
indent_size = unset

[LICENSE]
indent_style = unset
indent_size = unset
trim_trailing_whitespace = false
insert_final_newline = unset
