{
  "format": "atomik-project",
  "version": 24,
  "sample_rate": 48000,
  "tempo_bpm": 120,
  "seed": 0,
  "output_channels": 2,
  "input_channels": 2,
  "devices": [
    {
      "id": "layer", "type": "atomik.container",
      "name": "Layer", "folded": false,
      "params": {
        "macro1": 0.5,
        "macro2": 0.4
      },
      "inner": {
        "devices": [
          {
            "id": "low", "type": "atomik.poly-synth",
            "name": "Low", "folded": false,
            "params": {
              "env.amp.attack": 8,
              "env.amp.decay": 250,
              "env.amp.release": 180,
              "env.amp.sustain": 0.7,
              "filter.cutoff": 900,
              "filter.resonance": 0.2,
              "master.level": -8,
              "osc.mix": 0,
              "osc1.wave": 1,
              "voices": 4
            }
          },
          {
            "id": "high", "type": "atomik.poly-synth",
            "name": "High", "folded": false,
            "params": {
              "env.amp.attack": 8,
              "env.amp.decay": 250,
              "env.amp.release": 180,
              "env.amp.sustain": 0.7,
              "filter.cutoff": 3000,
              "filter.resonance": 0.2,
              "master.level": -12,
              "osc.mix": 0,
              "osc1.wave": 0,
              "voices": 4
            }
          },
          {
            "id": "mix", "type": "atomik.line-mixer",
            "name": "Mix", "folded": false
          },
          {
            "id": "echo", "type": "atomik.stereo-delay",
            "name": "Echo", "folded": false,
            "params": {
              "feedback": 0.35,
              "mix": 0.25,
              "time.ms": 375
            }
          }
        ],
        "cables": [
          {"from": "echo:out_l", "to": "boundary:out_l"},
          {"from": "echo:out_r", "to": "boundary:out_r"},
          {"from": "high:out_l", "to": "mix:ch2_in_l"},
          {"from": "high:out_r", "to": "mix:ch2_in_r"},
          {"from": "low:out_l", "to": "mix:ch1_in_l"},
          {"from": "low:out_r", "to": "mix:ch1_in_r"},
          {"from": "mix:master_l", "to": "echo:in_l"},
          {"from": "mix:master_r", "to": "echo:in_r"}
        ],
        "macros": [
          {"name": "Bright", "targets": [
            {"device": "low", "param": "filter.cutoff", "min": 400, "max": 3200},
            {"device": "high", "param": "filter.cutoff", "min": 6000, "max": 800},
            {"device": "echo", "param": "mix", "min": 0.1, "max": 0.5}
          ]},
          {"name": "Space", "targets": [
            {"device": "echo", "param": "feedback", "min": 0.1, "max": 0.7}
          ]},
          {"name": "", "targets": []},
          {"name": "", "targets": []},
          {"name": "", "targets": []},
          {"name": "", "targets": []},
          {"name": "", "targets": []},
          {"name": "", "targets": []}
        ],
        "splits": [
          {"target": "low", "key_lo": 0, "key_hi": 59, "vel_lo": 1, "vel_hi": 127, "transpose": 0},
          {"target": "high", "key_lo": 60, "key_hi": 127, "vel_lo": 1, "vel_hi": 127, "transpose": 12}
        ]
      }
    },
    {
      "id": "channel", "type": "atomik.channel",
      "name": "Console Channel", "folded": false
    },
    {
      "id": "master", "type": "atomik.master",
      "name": "Console Master", "folded": false
    },
    {
      "id": "tone", "type": "atomik.container",
      "name": "Tone", "folded": false,
      "params": {
        "macro1": 0.5
      },
      "inner": {
        "devices": [
          {
            "id": "comp", "type": "atomik.compressor",
            "name": "Comp", "folded": false,
            "params": {
              "lookahead": 2,
              "ratio": 3
            }
          },
          {
            "id": "space", "type": "atomik.container",
            "name": "Space", "folded": false,
            "inner": {
              "devices": [
                {
                  "id": "rev", "type": "atomik.reverb",
                  "name": "Reverb", "folded": false,
                  "params": {
                    "decay": 1.8
                  }
                }
              ],
              "cables": [
                {"from": "boundary:in_l", "to": "rev:in_l"},
                {"from": "boundary:in_r", "to": "rev:in_r"},
                {"from": "rev:out_l", "to": "boundary:out_l"},
                {"from": "rev:out_r", "to": "boundary:out_r"}
              ],
              "macros": [
                {"name": "", "targets": []},
                {"name": "", "targets": []},
                {"name": "", "targets": []},
                {"name": "", "targets": []},
                {"name": "", "targets": []},
                {"name": "", "targets": []},
                {"name": "", "targets": []},
                {"name": "", "targets": []}
              ],
              "splits": []
            }
          }
        ],
        "cables": [
          {"from": "boundary:in_l", "to": "comp:in_l"},
          {"from": "boundary:in_r", "to": "comp:in_r"},
          {"from": "comp:out_l", "to": "space:in_l"},
          {"from": "comp:out_r", "to": "space:in_r"},
          {"from": "space:out_l", "to": "boundary:out_l"},
          {"from": "space:out_r", "to": "boundary:out_r"}
        ],
        "macros": [
          {"name": "Tone", "targets": [
            {"device": "comp", "param": "threshold", "min": -6, "max": -30},
            {"device": "space/rev", "param": "mix", "min": 0.05, "max": 0.35}
          ]},
          {"name": "", "targets": []},
          {"name": "", "targets": []},
          {"name": "", "targets": []},
          {"name": "", "targets": []},
          {"name": "", "targets": []},
          {"name": "", "targets": []},
          {"name": "", "targets": []}
        ],
        "splits": []
      }
    }
  ],
  "cables": [
    {"from": "channel:insert_send_l", "to": "tone:in_l"},
    {"from": "channel:insert_send_r", "to": "tone:in_r"},
    {"from": "channel:out_l", "to": "master:bus_l"},
    {"from": "channel:out_r", "to": "master:bus_r"},
